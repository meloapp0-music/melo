# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# Cloudflare Pages Functions local secrets (TICKETMASTER_KEY etc.)
.dev.vars
**/.dev.vars

# wrangler local build/cache
.wrangler/
**/.wrangler/

# supabase CLI
supabase/.branches
supabase/.temp

# Claude Code agent scratch (worktrees, etc — not for source control)
.claude/worktrees/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
